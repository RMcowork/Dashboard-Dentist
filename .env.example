# Copy to .env (git-ignored) and fill in. Never commit real tokens.

# demo     = generated in memory, no network (default)
# airtable = read from the Airtable base below
DATA_SOURCE=demo

# Airtable personal access token: https://airtable.com/create/tokens
# Scopes: data.records:read (dashboard) + data.records:write, schema.bases:read, schema.bases:write (seeding)
# Access: only the "Dental Clinic Demo" base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appTRu3aSv38OmmGV

# How long the server reuses Airtable data before fetching again (free plan: ~1,000 API calls/month)
AIRTABLE_CACHE_MINUTES=15

PORT=8940
