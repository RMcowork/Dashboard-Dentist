# Copy to .env (git-ignored) and fill in. Never commit real tokens.

# auto     = Airtable when AIRTABLE_TOKEN is set, otherwise demo (default)
# demo     = generated in memory, no network
# airtable = read from the Airtable base below
DATA_SOURCE=auto

# Airtable personal access token: https://airtable.com/create/tokens
# Scope for the dashboard: data.records:read  (seeding also needs data.records:write, schema.bases:read/write)
# Access: only the "Dental Clinic Demo" base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appTRu3aSv38OmmGV

# Server-side protection of Airtable's API quota (free plan ≈ 1,000 calls/month):
# syncs closer together than this reuse the last result, whatever the browser asks for
AIRTABLE_MIN_INTERVAL_SECONDS=15
# full reload of every table (catches deletions); in between only changed records are fetched
AIRTABLE_FULL_SYNC_MINUTES=30

PORT=8940
